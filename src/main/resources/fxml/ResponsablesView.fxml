<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.ResponsablesController" styleClass="module-root"><top><VBox spacing="14"><HBox><VBox><Label text="Parents et responsables" styleClass="page-heading"/><Label text="Coordonnées des personnes responsables des élèves" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Nouveau" onAction="#clear" styleClass="primary-button"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox><HBox styleClass="toolbar"><TextField fx:id="searchField" promptText="Nom ou téléphone..." HBox.hgrow="ALWAYS" styleClass="search-field"/><Label fx:id="countLabel" styleClass="count-badge"/></HBox></VBox></top><center><SplitPane dividerPositions="0.68" styleClass="module-split"><TableView fx:id="table"><columns><TableColumn fx:id="nomCol" text="Nom complet" prefWidth="250"/><TableColumn fx:id="lienCol" text="Lien" prefWidth="100"/><TableColumn fx:id="telephoneCol" text="Téléphone" prefWidth="145"/><TableColumn fx:id="professionCol" text="Profession" prefWidth="170"/><TableColumn fx:id="elevesCol" text="Élèves" prefWidth="80"/></columns></TableView><ScrollPane fitToWidth="true" styleClass="transparent-scroll"><VBox styleClass="form-card"><Label fx:id="formTitle" text="Nouveau responsable" styleClass="form-title"/><HBox spacing="8"><VBox HBox.hgrow="ALWAYS"><Label text="Nom *" styleClass="field-label"/><TextField fx:id="nomField"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Postnom" styleClass="field-label"/><TextField fx:id="postnomField"/></VBox></HBox><Label text="Prénom *" styleClass="field-label"/><TextField fx:id="prenomField"/><Label text="Lien avec l'élève *" styleClass="field-label"/><ComboBox fx:id="lienCombo" maxWidth="Infinity"/><Label text="Profession" styleClass="field-label"/><TextField fx:id="professionField"/><Label text="Téléphone *" styleClass="field-label"/><TextField fx:id="teleph