<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<TabPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.AcademicController" tabClosingPolicy="UNAVAILABLE" styleClass="module-root"><tabs>
 <Tab text="Années scolaires"><content><SplitPane dividerPositions="0.68"><VBox spacing="12" styleClass="card"><Label text="Historique des années scolaires" styleClass="card-title"/><TableView fx:id="yearTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="yearLabelCol" text="Libellé" prefWidth="180"/><TableColumn fx:id="yearStartCol" text="Début" prefWidth="130"/><TableColumn fx:id="yearEndCol" text="Fin" prefWidth="130"/><TableColumn fx:id="yearStateCol" text="État" prefWidth="120"/></columns></TableView><Button text="Définir comme année active" onAction="#activateYear" styleClass="warning-button"/></VBox><VBox styleClass="form-card"><Label text="Créer ou modifier une année" styleClass="form-title"/><Label text="Libellé" styleClass="field-label"/><TextField fx:id="yearLabelField" promptText="2026-2027"/><Label text="Date de début" styleClass="field-label"/><DatePicker fx:id="yearStartPicker" maxWidth="Infinity"/><Label text="Date de fin" styleClass="field-label"/><DatePicker fx:id="yearEndPicker" maxWidth="Infinity"/><Region VBox.vgrow="ALWAYS"/><Button text="Enregistrer" onAction="#saveYear" styleClass="success-button" maxWidth="Infinity"/><Button text="Nouveau" onAction="#clearYear" styleClass="secondary-button" maxWidth="Infinity"/></VBox></SplitPane></content></Tab>
 <Tab text="Périodes"><content><SplitPane dividerPositions="0.68"><VBox spacing="12" styleClass="card"><Label text="Périodes d’évaluation" styleClass="card-title"/><TableView fx:id="periodTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="periodNameCol" text="Période" prefWidth="180"/><TableColumn fx:id="periodTypeCol" text="Type" prefWidth="120"/><TableColumn fx:id="periodYearCol" text="Année" prefWidth="130"/><TableColumn fx:id="periodStartCol" text="Début" prefWidth="120"/><TableColumn fx:id="periodEndCol" text="Fin" prefWidth="120"/></columns></TableView></VBox><VBox styleClass="form-card"><Label text="Créer ou modifier une période" styleClass="form-title"/><Label text="Année scolaire" styleClass="field-label"/><ComboBox fx:id="periodYearCombo" maxWidth="Infinity"/><Label text="Nom" styleClass="field-label"/><TextField fx:id="periodNameField"/><Label text="Type" styleClass="field-label"/><ComboBox fx:id="periodTypeCombo" maxWidth="Infinity"/><Label text="Début" styleClass="field-label"/><DatePicker fx:id="periodStartPicker" maxWidth="Infinity"/><Label text="Fin" styleClass="field-label"/><DatePicker fx:id="periodEndPicker" maxWidth="Infinity"/><Region VBox.vgrow="ALWAYS"/><Button text="Enregistrer" onAction="#savePeriod" styleClass="success-button" maxWidth="Infinity"/><Button text="Nouveau" onAction="#clearPeriod" styleClass="secondary-button" maxWidth="Infinity"/><Button text="Supprimer" onAction="#deletePeriod" styleClass="danger-button" maxWidth="Infinity"/></VBox></SplitPane></content></Tab>
 </tabs></TabPane>
