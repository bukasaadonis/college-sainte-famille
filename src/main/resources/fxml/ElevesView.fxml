<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.image.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.ElevesController" styleClass="module-root">
 <top><VBox spacing="14"><HBox alignment="CENTER_LEFT"><VBox><Label text="Dossiers des élèves" styleClass="page-heading"/><Label text="Créer, consulter et mettre à jour les informations scolaires" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Nouveau dossier" onAction="#newStudent" styleClass="primary-button"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox><HBox styleClass="toolbar"><TextField fx:id="searchField" promptText="Rechercher par matricule, nom ou prénom..." styleClass="search-field" HBox.hgrow="ALWAYS"/><Label fx:id="countLabel" text="0 élève" styleClass="count-badge"/></HBox></VBox></top>
 <center><SplitPane dividerPositions="0.64" styleClass="module-split"><TableView fx:id="table"><columns><TableColumn fx:id="matriculeCol" text="Matricule" prefWidth="135"/><TableColumn fx:id="nomCol" text="Nom complet" prefWidth="230"/><TableColumn fx:id="sexeCol" text="Sexe" prefWidth="85"/><TableColumn fx:id="classeCol" text="Classe" prefWidth="120"/><TableColumn fx:id="anneeCol" text="Année" prefWidth="100"/><TableColumn fx:id="statutCol" text="Statut" prefWidth="90"/></columns></TableView>
  <ScrollPane fitToWidth="true" styleClass="transparent-scroll"><VBox styleClass="form-card"><HBox alignment="CENTER_LEFT"><VBox><Label fx:id="formTitle" text="Nouvel élève" styleClass="form-title"/><Label fx:id="matriculePreview" text="Généré automatiquement" styleClass="helper-text"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox alignment="CENTER"><StackPane styleClass="photo-box"><ImageView fx:id="photoView" fitWidth="105" fitHeight="112" preserveRatio="true"/></StackPane><Button text="Photo" onAction="#choosePhoto" styleClass="secondary-button"/></VBox></HBox>
   <Separator/><GridPane hgap="10" vgap="8"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
    <VBox GridPane.columnIndex="0"><Label text="Nom *" styleClass="field-label"/><TextField fx:id="nomField"/></VBox><VBox GridPane.columnIndex="1"><Label text="Postnom" styleClass="field-label"/><TextField fx:id="postnomField"/></VBox>
    <VBox GridPane.rowIndex="1" GridPane.columnIndex="0"><Label text="Prénom *" styleClass="field-label"/><TextField fx:id="prenomField"/></VBox><VBox GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="Sexe *" styleClass="field-label"/><ComboBox fx:id="sexeCombo" maxWidth="Infinity"/></VBox>
    <VBox GridPane.rowIndex="2" GridPane.columnIndex="0"><Label text="Date de naissance *" styleClass="field-label"/><DatePicker fx:id="naissancePicker" maxWidth="Infinity"/></VBox><VBox GridPane.rowIndex="2" GridPane.columnIndex="1"><Label text="Lieu de naissance" styleClass="field-label"/><TextField fx:id="lieuField"/></VBox>
    <VBox GridPane.rowIndex="3" GridPane.columnIndex="0"><Label text="Nationalité" styleClass="field-label"/><TextField fx:id="nationaliteField"/></VBox><VBox GridPane.rowIndex="3" GridPane.columnIndex="1"><Label text="État civil des parents" styleClass="field-label"/><ComboBox fx:id="etatParentsCombo" maxWidth="Infinity"/></VBox>
   </GridPane><Label text="Adresse" styleClass="field-label"/><TextField fx:id="adresseField"/><HBox spacing="10"><VBox HBox.hgrow="ALWAYS"><Label text="Téléphone" styleClass="field-label"/><TextField fx:id="telephoneField"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="E-mail" styleClass="field-label"/><TextField fx:id="emailField"/></VBox></HBox><HBox spacing="10"><VBox HBox.hgrow="ALWAYS"><Label text="Nom du père" styleClass="field-label"/><TextField fx:id="pereField"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Nom de la mère" styleClass="field-label"/><TextField fx:id="mereField"/></VBox></HBox><Label text="Établissement de provenance" styleClass="field-label"/><TextField fx:id="provenanceField"/>
   <VBox styleClass="soft-panel"><Label text="Inscription initiale (pour un nouveau dossier)" styleClass="field-label"/><HBox spacing="10"><ComboBox fx:id="classeCombo" promptText="Classe" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><ComboBox fx:id="anneeCombo" promptText="Année scolaire" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox></VBox><Label text="Statut" styleClass="field-label"/><ComboBox fx:id="statutCombo" maxWidth="Infinity"/><HBox spacing="10"><Button text="Enregistrer" onAction="#save" styleClass="success-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Supprimer" onAction="#delete" styleClass="danger-button"/></HBox>
  </VBox></ScrollPane></SplitPane></center>
</BorderPane>
