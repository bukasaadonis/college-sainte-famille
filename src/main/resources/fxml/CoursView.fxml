<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.CoursController" styleClass="module-root"><top><VBox spacing="14"><HBox><VBox><Label text="Cours et affectations" styleClass="page-heading"/><Label text="Associer les matières, classes et enseignants" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Nouveau cours" onAction="#clear" styleClass="primary-button"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox><HBox styleClass="toolbar"><TextField fx:id="searchField" promptText="Code, cours ou classe..." HBox.hgrow="ALWAYS" styleClass="search-field"/><Label fx:id="countLabel" styleClass="count-badge"/></HBox></VBox></top><center><SplitPane dividerPositions="0.7" styleClass="module-split"><TableView fx:id="table"><columns><TableColumn fx:id="codeCol" text="Code" prefWidth="100"/><TableColumn fx:id="nameCol" text="Cours" prefWidth="220"/><TableColumn fx:id="classCol" text="Classe" prefWidth="130"/><TableColumn fx:id="teacherCol" text="Enseignant" prefWidth="220"/><TableColumn fx:id="coefCol" text="Coefficient" prefWidth="100"/></columns></TableView><VBox styleClass="form-card"><Label fx:id="formTitle" text="Nouveau cours" styleClass="form-title"/><Label text="Nom du cours *" styleClass="field-label"/><TextField fx:id="nameField"/><Label text="Code unique *" styleClass="field-label"/><TextField fx:id="codeField"/><Label text="Classe *" styleClass="field-label"/><ComboBox fx:id="classCombo" maxWidth="Infinity"/><Label text="Enseignant" styleClass="field-label"/><ComboBox fx:id="teacherCombo" maxWidth="Infinity"/><Label text="Coefficient" styleClass="field-label"/><TextField fx:id="coefField" text="1.00"/><Label text="Description" styleClass="field-label"/><TextArea fx:id="descriptionArea" prefRowCount="4"/><Region VBox.vgrow="ALWAYS"/><Button text="Enregistrer" onAction="#save" styleClass="success-button" maxWidth="Infinity"/><Button text="Supprimer" onAction="#delete" styleClass="danger-button" maxWidth="Infinity"/></VBox></SplitPane></center></BorderPane>
