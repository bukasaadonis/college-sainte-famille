<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.BulletinsController" styleClass="module-root"><top><VBox spacing="14"><VBox><Label text="Résultats et bulletins" styleClass="page-heading"/><Label text="Calcul automatique des moyennes pondérées, rangs et décisions" styleClass="page-subtitle"/></VBox><HBox styleClass="card" spacing="12" alignment="BOTTOM_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Année scolaire" styleClass="field-label"/><ComboBox fx:id="yearCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Classe" styleClass="field-label"/><ComboBox fx:id="classCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Période" styleClass="field-label"/><ComboBox fx:id="periodCombo" maxWidth="Infinity"/></VBox><Button text="Calculer" onAction="#calculate" styleClass="primary-button"/><Button text="Enregistrer" onAction="#save" styleClass="success-button"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox></VBox></top><center><VBox spacing="12" styleClass="module-center"><Label fx:id="infoLabel" text="Aucun résultat calculé" styleClass="count-badge"/><TableView fx:id="table" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="rankCol" text="Rang" prefWidth="90"/><TableColumn fx:id="matriculeCol" text="Matricule" prefWidth="170"/><TableColumn fx:id="studentCol" text="Élève" prefWidth="380"/><TableColumn fx:id="averageCol" text="Moyenne" prefWidth="160"/><TableColumn fx:id="decisionCol" text="Décision" prefWidth="160"/></columns></TableView><VBox styleClass="soft-panel"><Label text="Règle appliquée" styleClass="field-label"/><Label text="La moyenne générale est calculée sur 20 en tenant compte du coefficient de chaque note. Une moyenne supérieure ou égale à 10/20 donne la décision ADMIS." wrapText="true" styleClass="helper-text"/></VBox></VBox></center></BorderPane>
