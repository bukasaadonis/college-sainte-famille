<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.UtilisateursController" styleClass="module-root"><top><VBox spacing="14"><HBox><VBox><Label text="Utilisateurs et accès" styleClass="page-heading"/><Label text="Comptes, rôles, statuts et sécurité d’accès" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Nouvel utilisateur" onAction="#clear" styleClass="primary-button"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox><HBox styleClass="toolbar"><TextField fx:id="searchField" promptText="Identifiant, nom ou e-mail..." HBox.hgrow="ALWAYS" styleClass="search-field"/><Label fx:id="countLabel" styleClass="count-badge"/></HBox></VBox></top><center><SplitPane dividerPositions="0.68" styleClass="module-split"><VBox spacing="10"><TableView fx:id="table" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="loginCol" text="Identifiant" prefWidth="130"/><TableColumn fx:id="nameCol" text="Nom complet" prefWidth="230"/><TableColumn fx:id="roleCol" text="Rôle" prefWidth="120"/><TableColumn fx:id="emailCol" text="E-mail" prefWidth="220"/><TableColumn fx:id="statusCol" text="Statut" prefWidth="90"/><TableColumn fx:id="blockedCol" text="Bloqué" prefWidth="80"/></columns></TableView><HBox alignment="CENTER_RIGHT"><Button text="Bloquer / débloquer le compte" onAction="#toggleBlock" styleClass="warning-button"/></HBox></VBox><ScrollPane fitToWidth="true" styleClass="transparent-scroll"><VBox styleClass="form-card"><Label fx:id="formTitle" text="Nouvel utilisateur" styleClass="form-title"/><Label text="Identifiant *" styleClass="field-label"/><TextField fx:id="loginField"/><HBox spacing="8"><VBox HBox.hgrow="ALWAYS"><Label text="Nom *" styleClass="field-label"/><TextField fx:id="nomField"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Postnom" styleClass="field-label"/><TextField fx:id="postnomField"/></VBox></HBox><Label text="Prénom *"