<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.EnseignantsController" styleClass="module-root"><top><VBox spacing="14"><HBox><VBox><Label text="Corps enseignant" styleClass="page-heading"/><Label text="Répertoire des enseignants et de leurs spécialités" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Nouveau" onAction="#clear" styleClass="primary-button"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox><HBox styleClass="toolbar"><TextField fx:id="searchField" promptText="Nom ou spécialité..." HBox.hgrow="ALWAYS" styleClass="search-field"/><Label fx:id="countLabel" styleClass="count-badge"/></HBox></VBox></top><center><SplitPane dividerPositions="0.7" styleClass="module-split"><TableView fx:id="table"><columns><TableColumn fx:id="nomCol" text="Nom complet" prefWidth="250"/><TableColumn fx:id="specialiteCol" text="Spécialité" prefWidth="200"/><TableColumn fx:id="emailCol" text="E-mail" prefWidth="230"/><TableColumn fx:id="telephoneCol" text="Téléphone" prefWidth="145"/><TableColumn fx:id="coursCol" text="Cours" prefWidth="70"/></columns></TableView><VBox styleClass="form-card"><Label fx:id="formTitle" text="Nouvel enseignant" styleClass="form-title"/><HBox spacing="8"><VBox HBox.hgrow="ALWAYS"><Label text="Nom *" styleClass="field-label"/><TextField fx:id="nomField"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Postnom" styleClass="field-label"/><TextField fx:id="postnomField"/></VBox></HBox><Label text="Prénom *" styleClass="field-label"/><TextField fx:id="prenomField"/><Label text="Spécialité" styleClass="field-label"/><TextField fx:id="specialiteField"/><Label text="E-mail" styleClass="field-label"/><TextField fx:id="emailField"/><Label text="Téléphone" styleClass="field-label"/><TextField fx:id="telephoneField"/><Region VBox.vgrow="ALWAYS"/><Button text="Enregistrer" onAction="#save" styleClass="success