<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.InscriptionsController" styleClass="module-root"><top><VBox spacing="14"><HBox><VBox><Label text="Inscriptions scolaires" styleClass="page-heading"/><Label text="Affecter les élèves aux classes pour chaque année scolaire" styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Exporter" onAction="#export" styleClass="secondary-button"/></HBox><HBox styleClass="toolbar"><TextField fx:id="searchField" promptText="Numéro, élève, matricule ou classe..." HBox.hgrow="ALWAYS" styleClass="search-field"/><Label fx:id="countLabel" styleClass="count-badge"/></HBox></VBox></top><center><VBox spacing="16" styleClass="module-center"><HBox styleClass="card" spacing="12" alignment="BOTTOM_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Année scolaire" styleClass="field-label"/><ComboBox fx:id="yearCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Élève disponible" styleClass="field-label"/><ComboBox fx:id="studentCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Classe" styleClass="field-label"/><ComboBox fx:id="classCombo" maxWidth="Infinity"/></VBox><VBox><Label text="Date" styleClass="field-label"/><DatePicker fx:id="datePicker"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Observations" styleClass="field-label"/><TextArea fx:id="observationsArea" prefRowCount="1"/></VBox><Button text="Inscrire" onAction="#save" styleClass="success-button"/></HBox><TableView fx:id="table" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="numberCol" text="N° inscription" prefWidth="145"/><TableColumn fx:id="matriculeCol" text="Matricule" prefWidth="130"/><TableColumn fx:id="studentCol" text="Élève" prefWidth="260"/><TableColumn fx:id="classCol" text="Classe" prefWidth="120"/><TableColumn fx:id="yearCol" text="Année" prefWidth="110"/><TableColumn fx:id="dateCol" text="Date" prefWidth="110"/><TableColumn fx:id="statusCol" text="Statut" prefWidth="100"/></columns></TableView><HBox alignment="CENTER_RIGHT"><Button text="Annuler l'inscription sélectionnée" onAction="#cancel" styleClass="danger-button"/></HBox></VBox></center></BorderPane>
