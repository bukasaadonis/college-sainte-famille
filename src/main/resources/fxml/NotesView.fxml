<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.college.saint.raphael.controllers.NotesController" styleClass="module-root"><top><VBox spacing="14"><VBox><Label text="Saisie des notes" styleClass="page-heading"/><Label text="Feuille de notes par classe, cours et période" styleClass="page-subtitle"/></VBox><HBox styleClass="card" spacing="12" alignment="BOTTOM_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Année scolaire" styleClass="field-label"/><ComboBox fx:id="yearCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Classe" styleClass="field-label"/><ComboBox fx:id="classCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Cours" styleClass="field-label"/><ComboBox fx:id="courseCombo" maxWidth="Infinity"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Période" styleClass="field-label"/><ComboBox fx:id="periodCombo" maxWidth="Infinity"/></VBox><Button text="Charger" onAction="#load" styleClass="primary-button"/></HBox></VBox></top><center><VBox spacing="12" styleClass="module-center"><HBox alignment="CENTER_LEFT"><Label fx:id="infoLabel" text="Sélectionnez les paramètres de la feuille" styleClass="count-badge"/><Region HBox.hgrow="ALWAYS"/><Button text="Enregistrer toutes les notes" onAction="#save" styleClass="success-button"/></HBox><TableView fx:id="table" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="matriculeCol" text="Matricule" prefWidth="170"/><TableColumn fx:id="studentCol" text="Élève" prefWidth="360"/><TableColumn fx:id="valueCol" text="Note (modifiable)" prefWidth="170"/><TableColumn fx:id="maxCol" text="Maximum" prefWidth="120"/><TableColumn fx:id="coefCol" text="Coefficient" prefWidth="120"/><TableColumn fx:id="percentCol" text="Pourcentage" prefWidth="140"/></columns></TableView><Label text="Conseil : double-cliquez dans une cellule de la colonne Note, saisissez la valeur puis appuyez sur Entrée." styleClass="helper-text"/></VBox></center></BorderPane>
